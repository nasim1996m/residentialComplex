datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN_STAFF
  MAINTENANCE_WORKER
  RESIDENT
}

enum BuildingStatus {
  COMPLETED
  UNDER_CONSTRUCTION
}

enum PaymentType {
  FULL_CASH
  INSTALLMENTS
}

enum OccupancyStatus {
  VACANT_UNSOLD
  VACANT_SOLD
  OWNER_OCCUPIED
  RENTED
}

enum TicketStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum PaymentKind {
  FULL_CASH
  DOWN_PAYMENT
  INSTALLMENT
  SUBSCRIPTION
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  fullName         String
  avatarUrl        String?
  gender           String?
  phone            String?
  role             Role      @default(RESIDENT)
  passwordHash     String
  isActive         Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  residentProfile  ResidentProfile?
  staffProfile     StaffProfile?
  workerProfile    WorkerProfile?
  sessions         Session[]
  recordedPayments Payment[]           @relation("PaymentRecordedBy")
  createdTickets   MaintenanceTicket[] @relation("TicketCreatedBy")
  auditLogs        AuditLog[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the cookie token; the raw token is never stored.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Building {
  id                 String         @id @default(uuid())
  buildingNumber     Int            @unique
  name               String
  status             BuildingStatus @default(COMPLETED)
  totalFloors        Int            @default(5)
  apartmentsPerFloor Int            @default(4)
  totalApartments    Int            @default(20)

  apartments Apartment[]
}

model Apartment {
  id              String    @id @default(uuid())
  buildingId      String
  building        Building  @relation(fields: [buildingId], references: [id])
  floorNumber     Int
  apartmentNumber Int
  sequentialCode  String    @unique // e.g. B01-F02-A07

  isSold            Boolean      @default(false)
  price             Decimal      @db.Decimal(12, 2)
  paymentType       PaymentType?
  downPayment       Decimal?     @db.Decimal(12, 2)
  installmentMonths Int?
  soldAt            DateTime?

  occupancyStatus OccupancyStatus @default(VACANT_UNSOLD)
  isOccupied      Boolean         @default(false) // Triggers Subscription Eligibility

  residents          ResidentProfile[]
  installments       Installment[]
  subscriptions      Subscription[]
  vehicles           Vehicle[]
  garageSpots        GarageSpot[]
  maintenanceTickets MaintenanceTicket[]
  payments           Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buildingId, floorNumber, apartmentNumber])
}

model ResidentProfile {
  id          String     @id @default(uuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  apartmentId String?
  apartment   Apartment? @relation(fields: [apartmentId], references: [id])

  isContractOwner    Boolean @default(false)
  idCardPhotoUrl     String?
  residenceCardUrl   String?
  hasAccessBadge     Boolean @default(false)
  badgeCode          String? @unique
  familyMembersCount Int     @default(1)

  vehicles  Vehicle[]
  createdAt DateTime  @default(now())

  @@index([apartmentId])
}

model Vehicle {
  id          String           @id @default(uuid())
  apartmentId String
  apartment   Apartment        @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  residentId  String?
  resident    ResidentProfile? @relation(fields: [residentId], references: [id], onDelete: SetNull)

  plateNumber   String  @unique
  makeModel     String
  color         String?
  rfidBadgeCode String? @unique

  createdAt DateTime @default(now())

  @@index([apartmentId])
}

model GarageSpot {
  id          String     @id @default(uuid())
  apartmentId String?
  apartment   Apartment? @relation(fields: [apartmentId], references: [id], onDelete: SetNull)

  spotNumber    String  @unique // e.g. G1-P104
  zoneFloor     String
  accessBarcode String? @unique
  isOccupied    Boolean @default(false)

  @@index([apartmentId])
}

model StaffProfile {
  id         String  @id @default(uuid())
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  department String
  isOnDuty   Boolean @default(false)
}

model WorkerProfile {
  id             String  @id @default(uuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization String
  isAvailable    Boolean @default(true)

  tickets MaintenanceTicket[]
}

model Service {
  id           String  @id @default(uuid())
  code         String  @unique
  name         String
  monthlyPrice Decimal @db.Decimal(10, 2)
  isAvailable  Boolean @default(true)
  // Default services are subscribed automatically when an apartment becomes occupied.
  isDefault    Boolean @default(false)

  subscriptions Subscription[]
}

model Subscription {
  id          String    @id @default(uuid())
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id])
  serviceId   String
  service     Service   @relation(fields: [serviceId], references: [id])

  startDate DateTime             @default(now())
  endDate   DateTime?
  isActive  Boolean              @default(true)
  charges   SubscriptionCharge[]

  @@unique([apartmentId, serviceId])
}

// One monthly bill per subscription per period, so billing can be re-run safely.
model SubscriptionCharge {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  period         String // YYYY-MM
  amount         Decimal      @db.Decimal(10, 2)
  isPaid         Boolean      @default(false)
  paidAt         DateTime?
  createdAt      DateTime     @default(now())

  payment Payment?

  @@unique([subscriptionId, period])
  @@index([period])
}

model Installment {
  id             String    @id @default(uuid())
  apartmentId    String
  apartment      Apartment @relation(fields: [apartmentId], references: [id])
  sequenceNumber Int
  dueDate        DateTime
  amount         Decimal   @db.Decimal(12, 2)
  isPaid         Boolean   @default(false)
  paidAt         DateTime?

  payment Payment?

  @@unique([apartmentId, sequenceNumber])
  @@index([dueDate])
}

model Payment {
  id            String              @id @default(uuid())
  kind          PaymentKind
  apartmentId   String
  apartment     Apartment           @relation(fields: [apartmentId], references: [id])
  installmentId String?             @unique
  installment   Installment?        @relation(fields: [installmentId], references: [id])
  chargeId      String?             @unique
  charge        SubscriptionCharge? @relation(fields: [chargeId], references: [id])
  amount        Decimal             @db.Decimal(12, 2)
  paymentDate   DateTime            @default(now())
  receiptUrl    String?
  notes         String?
  recordedById  String?
  recordedBy    User?               @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([apartmentId])
  @@index([kind])
}

model MaintenanceTicket {
  id          String         @id @default(uuid())
  apartmentId String
  apartment   Apartment      @relation(fields: [apartmentId], references: [id])
  workerId    String?
  worker      WorkerProfile? @relation(fields: [workerId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?          @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  title       String
  description String
  status      TicketStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}
