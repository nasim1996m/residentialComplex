# PostgreSQL connection strings. With Supabase: DATABASE_URL = transaction pooler (port 6543,
# add ?pgbouncer=true), DIRECT_URL = session pooler / direct connection (used by migrations).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Used once by `npm run db:seed` to create the first SUPER_ADMIN account.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="choose-a-long-unique-password"

# Optional: Google sign-in through Supabase Auth. Residents/staff sign in with the Gmail
# address the admin registered for them. In Supabase, enable the Google provider and add
# ${APP_URL}/auth/callback to Authentication -> URL Configuration -> Redirect URLs.
# APP_URL may be omitted on Vercel (the production domain is used). NEXT_PUBLIC_SUPABASE_URL /
# NEXT_PUBLIC_SUPABASE_ANON_KEY are accepted as alternatives to the two names below.
APP_URL="http://localhost:3000"
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
